# Public web lookup
FIRECRAWL_API_KEY=

# Optional AI enrichment
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Optional outbound proxies for cookie-session LinkedIn requests (HTTP/HTTPS only).
# Newline- or comma-separated: http://user:pass@host:port, host:port, or host:port:user:pass
PROXY_URLS=
# Refuse to send LinkedIn requests directly when no proxy is available
PROXY_REQUIRED=false
# Allow proxies on private/loopback addresses to be supplied from the browser (self-hosted only)
ALLOW_PRIVATE_PROXIES=false
